# .env für den Reporting-Stack — neben compose.yml ablegen (chmod 600).
# Enthält Passwörter und Schlüssel, gehört NICHT ins Repository.

# --- Anschluss an den Hilfecenter-Stack -------------------------------
# Netzname prüfen mit: docker network ls | grep hilfecenter
HILFECENTER_NETZ=luemobil-hilfecenter_default
# Name des PostgreSQL-Containers in diesem Netz und dessen Superuser
PG_HOST=postgres
PG_USER=luemobil
# Dasselbe Passwort wie POSTGRES_PASSWORD in der .env des Hilfecenters
POSTGRES_PASSWORD=

# --- Ticket-API (PostgREST) -------------------------------------------
# Passwort der Rolle api_zugang, gesetzt beim Ausführen von ticket-api/01_datenbank.sql
API_DB_PASSWORT=
# Signierschlüssel der API-Tokens (openssl rand -base64 48)
JWT_SECRET=

# --- Metabase ----------------------------------------------------------
# Passwort der Rolle metabase_app aus server/metabase_datenbank.sql
MB_DB_PASSWORT=
# Öffentliche Adresse der Dashboards (über Caddy)
MB_SITE_URL=https://reporting.swl-innovation.de
# Verschlüsselt die gespeicherten Datenbankzugänge (openssl rand -base64 32).
# NIE ändern oder verlieren — sonst kann Metabase lue_reporting nicht mehr lesen.
MB_ENCRYPTION_SECRET_KEY=
# Schlüssel für die eingebetteten Dashboards (openssl rand -hex 32).
# Geht über den Tresor ans Hilfecenter (secrets/metabase_embed_secret).
MB_EMBEDDING_SECRET_KEY=
# Port nur auf 127.0.0.1: für Caddy und den SSH-Tunnel der Admins
MB_PORT=3001

# --- Import ------------------------------------------------------------
IMPORT_CONF_DATEI=/etc/luemobil/import.conf
DUMPS_VERZEICHNIS=/srv/luemobil/dumps/eingang
ARCHIV_VERZEICHNIS=/srv/luemobil/archiv
FEHLER_VERZEICHNIS=/srv/luemobil/fehler
STATUS_VERZEICHNIS=/var/lib/luemobil-import
SICHERUNG_VERZEICHNIS=/var/backups/luemobil
SICHERUNG_TAGE=30

TZ=Europe/Berlin
