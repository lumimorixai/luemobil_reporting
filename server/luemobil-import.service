# /etc/systemd/system/luemobil-import.service
# Einmaliger Importlauf im Reporting-Stack. Gestartet vom Timer,
# manuell: systemctl start luemobil-import
[Unit]
Description=LüMobil: Datenbank-Dumps importieren
After=docker.service
Requires=docker.service
OnFailure=luemobil-meldung@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/luemobil
ExecStart=/usr/bin/docker compose run --rm import
TimeoutStartSec=2h
