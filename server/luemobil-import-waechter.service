# /etc/systemd/system/luemobil-import-waechter.service
# Schlägt fehl (und meldet), wenn der letzte erfolgreiche Import zu alt ist.
# Fängt den Fall ab, dass gar keine Dumps ankommen — dann meldet der Import selbst nichts.
[Unit]
Description=LüMobil: Aktualität der Daten prüfen
After=docker.service
OnFailure=luemobil-meldung@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/luemobil_reporting
ExecStart=/usr/bin/docker compose run --rm import --pruefen
