# /etc/systemd/system/luemobil-sicherung.service
# Sichert lue_reporting (Sichten, API-Funktion, Token-Register, Abfrageprotokoll)
# und metabase_app (Dashboards, Fragen, Konten, Einstellungen von Metabase).
# kk_mpswl/kk_swl werden NICHT gesichert — sie kommen jede Nacht neu vom Lieferanten.
[Unit]
Description=LüMobil: lue_reporting sichern
After=postgresql.service
OnFailure=luemobil-meldung@%n.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/bin/sh -c 'pg_dump -Fc -f /var/backups/luemobil/lue_reporting-$(date +%%Y%%m%%d).dump lue_reporting'
ExecStart=/bin/sh -c 'pg_dump -Fc -f /var/backups/luemobil/metabase_app-$(date +%%Y%%m%%d).dump metabase_app'
ExecStartPost=/usr/bin/find /var/backups/luemobil -name '*.dump' -mtime +30 -delete
