# /etc/luemobil/import.conf — Konfiguration für den Import
# Wird in den Container gemountet (siehe compose.yml). Rechte: root:root 644.
# Die Pfade sind die IM CONTAINER; worauf sie auf dem Server zeigen, steht in der .env.

# --- Verzeichnisse ---------------------------------------------------
EINGANG=/srv/luemobil/dumps      # Eingang des Lieferanten (SFTP), im Container gemountet
ARCHIV=/srv/luemobil/archiv      # erfolgreich importierte Dumps
FEHLER=/srv/luemobil/fehler      # abgewiesene Dumps, zur Analyse
STATUS=/var/lib/luemobil-import  # Sperre, Import-Register, letzter Status

# --- Datenbanken -----------------------------------------------------
DB_MPSWL=kk_mpswl
DB_SWL=kk_swl
DB_REPORTING=lue_reporting
# Verbindung kommt aus der Umgebung: PGHOST/PGUSER/PGPASSWORD in der .env.
# Rollen, die in den Dumps als Eigentümer vorkommen (ALTER ... OWNER TO) und im
# Zielcluster fehlen — dort heißt der Superuser luemobil —, legt der Import
# ohne Anmelderecht an:
DUMP_ROLLEN="postgres"

# --- Plausibilität ---------------------------------------------------
MIN_KUNDEN=1000                  # weniger Konten in kk_mpswl.customers = Fehler
MIN_BESTELLUNGEN=1000            # weniger Bestellungen = Fehler
MAX_RUECKGANG_PROZENT=5          # Tabelle schrumpft gegenüber gestern um mehr = Fehler
RAUCHTEST_SQL="SELECT count(*) FROM rpt.bestellposition"   # muss > 0 liefern

# --- Zeiten ----------------------------------------------------------
RUHEZEIT_MINUTEN=2               # Datei muss so lange unverändert sein (Upload fertig)
WARTEN_AUF_PARTNER_MINUTEN=360   # so lange auf den zweiten Dump warten, dann Fehler
ARCHIV_TAGE=7                    # Dumps enthalten Personendaten: danach löschen
MAX_ALTER_STUNDEN=30             # Wächter schlägt Alarm, wenn der letzte Import älter ist

# --- Benachrichtigung ------------------------------------------------
MELDUNG_AN="betrieb@luemobil.de"  # Empfänger für Fehlermeldungen (meldung.sh)
