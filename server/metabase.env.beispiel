# /etc/luemobil/metabase.env — Konfiguration für metabase.service
# Rechte: root:metabase 640 (enthält Passwort und Schlüssel)

# --- Nur lokal lauschen: nach außen geht es ausschließlich über nginx ---
MB_JETTY_HOST=127.0.0.1
MB_JETTY_PORT=3000
MB_SITE_URL=https://reporting.luemobil.de

# --- Anwendungsdatenbank (Dashboards, Konten, Einstellungen) --------
MB_DB_TYPE=postgres
MB_DB_HOST=localhost
MB_DB_PORT=5432
MB_DB_DBNAME=metabase_app
MB_DB_USER=metabase_app
MB_DB_PASS=<pw_app aus metabase_datenbank.sql>

# Verschlüsselt die Zugangsdaten zu lue_reporting in der Anwendungsdatenbank.
# Erzeugen: openssl rand -base64 32   — NIE ändern oder verlieren, sonst sind
# die gespeicherten Datenbankverbindungen unlesbar.
MB_ENCRYPTION_SECRET_KEY=<zufällig>

# --- Einbettung ins Hilfecenter --------------------------------------
MB_ENABLE_EMBEDDING_STATIC=true
# Erzeugen: openssl rand -hex 32. Wird über den Tresor ans Hilfecenter gegeben.
# Hier gesetzt, lässt er sich in der Oberfläche nicht versehentlich neu erzeugen.
MB_EMBEDDING_SECRET_KEY=<zufällig, 64 Hex-Zeichen>

# --- Keine Verbindungen nach außen -----------------------------------
MB_ANON_TRACKING_ENABLED=false
MB_CHECK_FOR_UPDATES=false

MB_PLUGINS_DIR=/var/lib/metabase/plugins
